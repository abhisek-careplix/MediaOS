# —— the site ——
# your hostname, pointed at the server (no domain yet? use <server-ip-with-dashes>.sslip.io, e.g. 34-120-5-6.sslip.io)
DOMAIN=videogen.careplix.com
PUBLIC_URL=https://videogen.careplix.com

# —— access ——
# 1 = a public site, no sign-in. Director mode is always off in this mode.
OPEN_ACCESS=1
# hourly limits on the public site: per visitor, and Claude calls for the whole site
LIMIT_SCRIPTS_PER_HOUR=15
LIMIT_RENDERS_PER_HOUR=8
LIMIT_CLAUDE_PER_HOUR=150

# —— Claude (console.anthropic.com → API keys); writes scripts and brand kits ——
ANTHROPIC_API_KEY=

# —— rendering ——
# full-film renders at once (each uses 4 browser workers)
RENDER_SLOTS=2

# —— later: CarePlix-only Google sign-in (see DEPLOY.md). Filling these in turns sign-in on and OPEN_ACCESS off. ——
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_DOMAINS=careplix.com
# SESSION_SECRET=            # openssl rand -hex 32
# SESSION_DAYS=7
# MAX_DIRECTORS=1            # Director productions at once; 0 = off
# DIRECTOR_USERS=            # optional: only these emails may start productions
# ADMIN_EMAILS=              # always admins: they give the sign-off roles on the Team page (comma-separated)

# —— backups: every data folder mirrored to a private, versioned Cloud Storage bucket (gcp-up.sh sets MEDIA_BUCKET) ——
# MEDIA_BUCKET=              # unset = no backups
# MEDIA_PREFIX=studio/
# STORAGE_SYNC_MINUTES=10
# DRAIN_MINUTES=15           # on a deploy, how long running renders and shoots may finish before the old server stops
# DIRECTOR_PERMISSION_MODE=auto

# Generated storyboard frames (Productions) use Vertex AI in this Google Cloud project, with no key: on the VM its own
# service account (deploy/gcp-up.sh gives it access), on a laptop your gcloud sign-in. Optional overrides:
# VERTEX_PROJECT=careplix-labs
# VERTEX_LOCATION=global
# VERTEX_IMAGE_MODEL=gemini-3.1-flash-image
# VERTEX_LOOK_MODEL=gemini-3.8-flash          (the continuity check on each take)

# Video shots (Productions): the Standard and Premium engines use Vertex AI like the frames, with no key. A fal.ai key
# turns on the rest of the studio: the Character engine, studio voices, talking shots, each take's sound and the score.
# Set it with ./deploy/gcp-keys.sh rather than by hand.
# FAL_KEY=
# FAL_KLING_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# VOICE_MODEL=fal-ai/elevenlabs/tts/eleven-v3
# TALK_MODEL=fal-ai/bytedance/omnihuman/v1.5
# TALK_FALLBACK_MODEL=fal-ai/kling-video/ai-avatar/v2/pro
# MUSIC_MODEL=fal-ai/elevenlabs/music
# AMBIENCE_MODEL=fal-ai/elevenlabs/sound-effects/v2
